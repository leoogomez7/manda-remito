# Browser-side Kinde configuration (public client ID and issuer domain)
DOMAIN_USER=https://YOUR_KINDE_DOMAIN.kinde.com
AUTH_USER=YOUR_KINDE_CLIENT_ID
CODE_ORG=YOUR_KINDE_ORGANIZATION_CODE
AUTH_CONNECTION_ID=

# Server-only. Never add these to VITE_* variables or expose them to the browser.
KINDE_ISSUER_URL=https://YOUR_KINDE_DOMAIN.kinde.com
KINDE_CLIENT_ID=YOUR_KINDE_CLIENT_ID
TURSO_DATABASE_URL=libsql://YOUR_DATABASE-YOUR_ORG.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_DATABASE_TOKEN

# Server-only. Checkout Pro uses the access token; the public key is for future client-side SDK/Brick flows.
MERCADOPAGO_ACCESS_TOKEN=YOUR_MERCADOPAGO_ACCESS_TOKEN
MERCADOPAGO_PUBLIC_KEY=YOUR_MERCADOPAGO_PUBLIC_KEY
# Server-only value of the promotional code that grants a 100% discount.
GRATIS2026=GRATIS2026
# Optional public site origin for Mercado Pago return URLs (for example https://your-domain.com)
APP_URL=
