{
  "compilerOptions": {
    "types": ["vite/client"],
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,

    "jsx": "react-jsx",

    "strict": true,
    "resolveJsonModule": true,

    "paths": {
      "@/*": ["./src/*"],
      "*": ["./*"]
    }
  },

  "include": ["src"]
}